# Copia este fichero a .env y ajusta las rutas.

# --- Rutas en el NAS ---------------------------------------------------------
# La biblioteca es la carpeta de originales que YA tiene paperless. Alejandria
# la lee y escribe dentro, pero nunca la reorganiza por su cuenta.
BIBLIOTECA=/ruta/a/paperless/data/documents/originals
# El buzón: lo que se deje aquí se archiva solo. Se puede reutilizar el de paperless.
ENTRADA=/ruta/a/paperless/consume
# Solo para la importación inicial (ver LEEME): carpeta raíz de paperless.
# PAPERLESS=/ruta/a/paperless

# --- Servicio ----------------------------------------------------------------
PUERTO=8890
# Usuario:grupo con el que corre Alejandria, para que los ficheros que cree sean
# tuyos y no de root. En QTS el grupo NO se llama como el usuario: 1000:100.
USUARIO=1000:100
ALEJANDRIA_SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
ALEJANDRIA_DEBUG=0
# IP local del NAS, IP de la VPN, nombre de host… separados por comas.
ALEJANDRIA_HOSTS=192.168.1.10,localhost
ALEJANDRIA_CSRF_ORIGINS=http://192.168.1.10:8890

# Dentro del contenedor las rutas son siempre estas; no las toques.
ALEJANDRIA_BIBLIOTECA=/biblioteca
ALEJANDRIA_ENTRADA=/entrada
ALEJANDRIA_DATOS=/datos

# --- Comportamiento ----------------------------------------------------------
ALEJANDRIA_LOGIN=0                 # 1 para exigir usuario y contraseña
ALEJANDRIA_MINIATURAS=1
ALEJANDRIA_MINIATURA_LIMITE_MB=220
ALEJANDRIA_VIGILANTE_INTERVALO=30
ALEJANDRIA_PATRON={anio}/{corresponsal}/{titulo}{ext}
TZ=Europe/Madrid
